// Este schema do Prisma é a FONTE DA VERDADE do banco de dados do módulo
// Centro de Security QA (Bounded Context isolado). Migrações são geradas a
// partir dele; em Supabase/PostgreSQL a tabela public.qa_results já é criada
// aqui (e não mais via supabase-security-qa.sql manual).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// QaProject — um projeto avaliado (1 : N com QaResult).
// ---------------------------------------------------------------------------
model QaProject {
  id            String      @id @default(uuid()) @db.Uuid
  name          String      @unique
  environmentUrl String     @map("environment_url")
  requirements  String
  createdBy     String?     @map("created_by") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  results       QaResult[]

  @@map("qa_projects")
}

// ---------------------------------------------------------------------------
// QaResult — resultado de uma avaliação de segurança de um projeto.
// Mantém TODAS as colunas exigidas pelo motor /api/qa-engine.
//
// Lifecycle de background (Inngest): o publisher cria a linha apenas com
// status 'PROCESSANDO'; os campos de conformidade/arquivamento/PDF são
// preenchidos pelo worker ao concluir (UPDATE status -> 'CONCLUIDO').
// ---------------------------------------------------------------------------
model QaResult {
  id                String   @id @default(uuid()) @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  project           QaProject @relation(fields: [projectId], references: [id])

  originalFileName  String   @map("original_file_name")
  tempStoragePath   String?  @map("temp_storage_path")
  archivedFilePath  String?  @map("archived_file_path")
  archivedFileUrl   String?  @map("archived_file_url")
  archivedSizeBytes BigInt?  @map("archived_size_bytes")
  originalSizeBytes BigInt?  @map("original_size_bytes")
  compressionRatio  Decimal? @map("compression_ratio") @db.Decimal(10, 4)
  compliancePercent Decimal? @map("compliance_percent") @db.Decimal(5, 2)
  overallRating     String?  @map("overall_rating")
  executiveSummary  String?  @map("executive_summary")
  findings          Json     @default("[]")
  status            String   @default("PROCESSANDO") // PROCESSANDO | CONCLUIDO | FALHA
  errorMessage      String?  @map("error_message")
  pdfFilePath       String?  @map("pdf_file_path")
  pdfFileUrl        String?  @map("pdf_file_url")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([createdAt(sort: Desc)])
  @@index([status])
  @@map("qa_results")
}

// ---------------------------------------------------------------------------
// Sprint — Iteração de entrega do módulo de Gestão de Demandas (1 : N Ticket).
// ---------------------------------------------------------------------------
model Sprint {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  goal      String?
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")
  status    String    @default("PLANEJADA") // PLANEJADA | ATIVA | CONCLUIDA
  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  tickets   Ticket[]

  @@index([status])
  @@index([startDate])
  @@map("sprints")
}

// ---------------------------------------------------------------------------
// NotificationSetting — Preferências de notificação (e-mail/SMS/in-app).
// ---------------------------------------------------------------------------
model NotificationSetting {
  id          String   @id @default(uuid()) @db.Uuid
  eventType   String   @map("event_type") // ticket_created | ticket_updated | due_date | sprint_start
  channel     String   @default("email") // email | in_app | sms
  enabled     Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([eventType, channel])
  @@map("notification_settings")
}

// ---------------------------------------------------------------------------
// IntegrationConnection — Conexões de integração IAM via OAuth2/SAML/SCIM.
// (Espelha a tabela public.integration_connections do Supabase.)
// ---------------------------------------------------------------------------
model IntegrationConnection {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  protocol     String // oauth2 | saml | scim
  config       Json     @default("{}")
  isActive     Boolean  @default(true) @map("is_active")
  lastStatus   String?  @map("last_status")
  lastTestedAt DateTime? @map("last_tested_at")
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([protocol])
  @@map("integration_connections")
}

// ---------------------------------------------------------------------------
// MtlsConfig — Configuração global de Mutual TLS (singleton id = 'global').
// ---------------------------------------------------------------------------
model MtlsConfig {
  id                String   @id @default("global")
  enabled           Boolean  @default(false)
  caCert            String?  @map("ca_cert")
  clientCert        String?  @map("client_cert")
  clientKey         String?  @map("client_key")
  requireClientCert Boolean  @default(true) @map("require_client_cert")
  updatedBy         String?  @map("updated_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("mtls_configs")
}

// ---------------------------------------------------------------------------
// EnterpriseTool — Integrações com ferramentas enterprise (Jira/ServiceNow/O365).
// ---------------------------------------------------------------------------
model EnterpriseTool {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  toolType     String   @map("tool_type") // jira | servicenow | office365
  config       Json     @default("{}")
  isActive     Boolean  @default(true) @map("is_active")
  lastStatus   String?  @map("last_status")
  lastTestedAt DateTime? @map("last_tested_at")
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([toolType])
  @@map("enterprise_tools")
}

// ---------------------------------------------------------------------------
// Ticket — Módulo de Gestão de Demandas (Estrutura Hierárquica Jira/Trello).
// ---------------------------------------------------------------------------
enum TicketType {
  EPICO
  ATIVIDADE
  TAREFA
}

model Ticket {
  id              String       @id @default(uuid()) @db.Uuid
  title           String
  description     String?
  type            TicketType
  status          String       @default("ABERTO")
  priority        String       @default("media")
  assignee        String       @map("assignee")
  parentEpicId    String?      @map("parent_epic_id") @db.Uuid
  parentEpic      Ticket?      @relation("EpicHierarchy", fields: [parentEpicId], references: [id], onDelete: SetNull)
  childTickets    Ticket[]     @relation("EpicHierarchy")
  tags            String[]     @default([])
  frameworkOrigem String?      @map("framework_origem")
  reporterId      String?      @map("reporter_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  closedAt        DateTime?    @map("closed_at")

  attachmentName  String?      @map("attachment_name")
  attachmentUrl   String?      @map("attachment_url")

  dueDate         DateTime?    @map("due_date")
  sprintId        String?      @map("sprint_id") @db.Uuid
  sprint          Sprint?      @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([type])
  @@index([parentEpicId])
  @@index([sprintId])
  @@index([dueDate])
  @@map("tickets")
}

// ---------------------------------------------------------------------------
// LlmCallLog — Logs reais de chamadas de inteligência artificial para o painel.
// ---------------------------------------------------------------------------
model LlmCallLog {
  id         String   @id @default(uuid()) @db.Uuid
  provider   String   // google | openai | openrouter | groq | fallback
  model      String
  route      String   // ex: /api/qa-engine, /api/chat
  status     String   // SUCESSO | FALLBACK | FALHA
  latencyMs  Int      @map("latency_ms")
  tokensUsed Int?     @map("tokens_used")
  costEst    Decimal? @map("cost_est") @db.Decimal(10, 6)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([provider])
  @@index([createdAt(sort: Desc)])
  @@map("llm_call_logs")
}

// ---------------------------------------------------------------------------
// KnowledgeArticle — Artigos de conhecimento para RAG via pgvector.
// ---------------------------------------------------------------------------
model KnowledgeArticle {
  id        String                    @id @default(uuid()) @db.Uuid
  title     String
  source    String
  content   String
  embedding Unsupported("vector(3072)")?
  createdAt DateTime                  @default(now()) @map("created_at")

  @@map("knowledge_articles")
}